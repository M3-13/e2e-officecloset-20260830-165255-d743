# Copy this file to `.env` (in the `backend/` directory) and fill in the values
# before starting the backend:
#
#   cd backend
#   copy .env.example .env          (Windows)
#   cp .env.example .env            (macOS/Linux)
#
# JWT_SECRET is a per-deployment secret. There is no value committed here on
# purpose — generate one and paste it below, e.g.:
#
#   py -c "import secrets; print(secrets.token_hex(32))"

JWT_SECRET=

DATABASE_URL=sqlite:///./wardrobe.db
UPLOAD_DIR=./uploads
FRONTEND_ORIGIN=http://localhost:5173
MAX_UPLOAD_SIZE=5242880
